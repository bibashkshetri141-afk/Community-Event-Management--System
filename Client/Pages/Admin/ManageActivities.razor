@page "/admin/activities"
@using Client.Shared
@inject ApiService Api

<AdminGuard>
    <div class="page-header">
        <h2>🎯 Manage Activities</h2>
        <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Activity</button>
    </div>


    @if (showForm)
    {
        <div class="card" style="margin-bottom:20px">
            <h3>@(editingActivity.Id == 0 ? "Add New Activity" : "Edit Activity")</h3>
            <div class="form-group">
                <label>Name</label>
                <input @bind="editingActivity.Name" placeholder="Activity name" />
            </div>
            <div class="form-group">
                <label>Type</label>
                <select @bind="editingActivity.Type">
                    <option value="">-- Select type --</option>
                    <option value="Workshop">Workshop</option>
                    <option value="Talk">Talk</option>
                    <option value="Game">Game</option>
                    <option value="Performance">Performance</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea @bind="editingActivity.Description" placeholder="Description" rows="3"></textarea>
            </div>
            @if (formError != null)
            {
                <div class="alert alert-danger">@formError</div>
            }
            <button class="btn btn-success" @onclick="SaveActivity">Save</button>
            <button class="btn btn-secondary" @onclick="HideForm">Cancel</button>
        </div>
    }

    @if (loading)
    {
        <p>Loading...</p>
    }
    else if (activities == null || !activities.Any())
    {
        <div class="alert alert-info">No activities yet. Add one above.</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var activity in activities)
                {
                    <tr>
                        <td>@activity.Name</td>
                        <td><span class="badge badge-success">@activity.Type</span></td>
                        <td>@activity.Description</td>
                        <td>
                            <button class="btn btn-secondary" @onclick="() => EditActivity(activity)">Edit</button>
                            <button class="btn btn-danger" @onclick="() => DeleteActivity(activity.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

@code {
    private List<Activity>? activities;
    private Activity editingActivity = new();
    private bool showForm = false;
    private bool loading = true;
    private string? formError = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadActivities();
        loading = false;
    }

    private async Task LoadActivities()
    {
        activities = await Api.GetActivitiesAsync();
    }

    private void ShowAddForm()
    {
        editingActivity = new Activity();
        formError = null;
        showForm = true;
    }

    private void HideForm()
    {
        showForm = false;
        formError = null;
    }

    private void EditActivity(Activity activity)
    {
        editingActivity = new Activity
        {
            Id = activity.Id,
            Name = activity.Name,
            Type = activity.Type,
            Description = activity.Description
        };
        formError = null;
        showForm = true;
    }

    private async Task SaveActivity()
    {
        if (string.IsNullOrWhiteSpace(editingActivity.Name))
        {
            formError = "Name is required.";
            return;
        }

        if (editingActivity.Id == 0)
            await Api.CreateActivityAsync(editingActivity);
        else
            await Api.UpdateActivityAsync(editingActivity);

        await LoadActivities();
        HideForm();
    }

    private async Task DeleteActivity(int id)
    {
        await Api.DeleteActivityAsync(id);
        await LoadActivities();
    }
}
</AdminGuard>