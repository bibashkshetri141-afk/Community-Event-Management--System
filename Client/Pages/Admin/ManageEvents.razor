@page "/admin/events"
@using Client.Shared
@inject ApiService Api

<AdminGuard>
    <div class="page-header">
        <h2>📅 Manage Events</h2>
        <button class="btn btn-primary" @onclick="ShowAddForm">+ Add Event</button>
    </div>

    @if (showForm)
    {
        <div class="card" style="margin-bottom:20px">
            <h3>@(editingEvent.Id == 0 ? "Add New Event" : "Edit Event")</h3>
            <div class="form-group">
                <label>Event Name</label>
                <input @bind="editingEvent.Name" placeholder="Event name" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea @bind="editingEvent.Description" placeholder="Description" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label>Date</label>
                <input type="date" @bind="editingEvent.Date" />
            </div>
            <div class="form-group">
                <label>Time</label>
                <input type="time" value="@editingEvent.Time"
                       @onchange="e => editingEvent.Time = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="form-group">
                <label>Venue</label>
                <select @bind="editingEvent.VenueId">
                    <option value="0">-- Select venue --</option>
                    @foreach (var venue in venues ?? new())
                    {
                        <option value="@venue.Id">@venue.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Activities</label>
                <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:6px">
                    @foreach (var activity in activities ?? new())
                    {
                        <label style="display:flex; align-items:center; gap:6px; cursor:pointer">
                            <input type="checkbox" checked="@selectedActivityIds.Contains(activity.Id)"
                                   @onchange="e => ToggleActivity(activity.Id, (bool)e.Value!)" />
                            @activity.Name
                            <span class="badge badge-success">@activity.Type</span>
                        </label>
                    }
                </div>
            </div>
            @if (formError != null)
            {
                <div class="alert alert-danger">@formError</div>
            }
            <button class="btn btn-success" @onclick="SaveEvent">Save</button>
            <button class="btn btn-secondary" @onclick="HideForm">Cancel</button>
        </div>
    }

    @if (loading)
    {
        <p>Loading...</p>
    }
    else if (events == null || !events.Any())
    {
        <div class="alert alert-info">No events yet. Add one above.</div>
    }
    else
    {
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Date</th>
                    <th>Time</th>
                    <th>Venue</th>
                    <th>Activities</th>
                    <th>Registrations</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ev in events)
                {
                    <tr>
                        <td>@ev.Name</td>
                        <td>@ev.Date.ToString("dd MMM yyyy")</td>
                        <td>@ev.Time</td>
                        <td>@(ev.Venue?.Name ?? "—")</td>
                        <td>
                            @foreach (var ea in ev.EventActivities ?? new())
                            {
                                <span class="badge badge-success" style="margin-right:4px">
                                    @ea.Activity?.Name
                                </span>
                            }
                        </td>
                        <td>@(ev.Registrations?.Count ?? 0)</td>
                        <td>
                            <button class="btn btn-secondary" @onclick="() => EditEvent(ev)">Edit</button>
                            <button class="btn btn-danger" @onclick="() => DeleteEvent(ev.Id)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

@code {
    private List<Event>? events;
    private List<Venue>? venues;
    private List<Activity>? activities;

    private Event editingEvent = new();
    private List<int> selectedActivityIds = new();

    private bool showForm = false;
    private bool loading = true;
    private string? formError = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
        loading = false;
    }

    private async Task LoadAll()
    {
        events = await Api.GetEventsAsync();
        venues = await Api.GetVenuesAsync();
        activities = await Api.GetActivitiesAsync();
    }

    private void ShowAddForm()
    {
        editingEvent = new Event { Date = DateTime.Today };
        selectedActivityIds = new();
        formError = null;
        showForm = true;
    }

    private void HideForm()
    {
        showForm = false;
        formError = null;
    }

    private void EditEvent(Event ev)
    {
        editingEvent = new Event
        {
            Id = ev.Id,
            Name = ev.Name,
            Description = ev.Description,
            Date = ev.Date,
            Time = ev.Time,
            VenueId = ev.VenueId
        };
        selectedActivityIds = ev.EventActivities?
            .Select(ea => ea.ActivityId)
            .ToList() ?? new();
        formError = null;
        showForm = true;
    }

    private void ToggleActivity(int activityId, bool isChecked)
    {
        if (isChecked && !selectedActivityIds.Contains(activityId))
            selectedActivityIds.Add(activityId);
        else if (!isChecked)
            selectedActivityIds.Remove(activityId);
    }

    private async Task SaveEvent()
    {
        if (string.IsNullOrWhiteSpace(editingEvent.Name))
        {
            formError = "Event name is required.";
            return;
        }
        if (editingEvent.VenueId == 0)
        {
            formError = "Please select a venue.";
            return;
        }

        // Attach selected activities
        editingEvent.EventActivities = selectedActivityIds.Select(id => new EventActivity
        {
            ActivityId = id
        }).ToList();

        if (editingEvent.Id == 0)
            await Api.CreateEventAsync(editingEvent);
        else
            await Api.UpdateEventAsync(editingEvent);

        await LoadAll();
        HideForm();
    }

    private async Task DeleteEvent(int id)
    {
        await Api.DeleteEventAsync(id);
        await LoadAll();
    }
}
</AdminGuard>